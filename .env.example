# Database (PostgreSQL)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev
POSTGRES_DB=sentinel_x
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev@localhost:5432/sentinel_x

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend Authentication
SENTINEL_API_KEY=dev-secret-key

# Auth & JWT Configuration
JWT_SECRET=sentinel-dev-jwt-secret-change-in-prod-32chars
JWT_EXPIRE_MINUTES=480
ALLOW_DEV_HEADERS=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Live LLM Configuration (OpenAI-compatible endpoints: Ollama, Groq, Google Gemini, Hugging Face)
SENTINEL_LIVE_LLM=false
LLM_PROVIDER=Provider
LLM_BASE_URL=openai-compatible-url
LLM_API_KEY=api-key
LLM_MODEL=model
